{
  "name": "@asseteragmbh/evm-contracts",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Assetera EVM contracts — ABIs, per-chain addresses, and a viem client.",
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/contracts/abi/*.json",
    "src/deployments/*.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "viem": "^2.21.0"
  }
}
