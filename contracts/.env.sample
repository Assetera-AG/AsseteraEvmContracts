# ─────────────────────────────────────────────
# contracts/.env  —  Forge deployment config
# Copy to .env and fill in the values.
# Never commit .env — it contains private keys.
# ─────────────────────────────────────────────

# ── RPC endpoints ────────────────────────────
# Used by forge script --rpc-url
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POLYGON_RPC_URL=
MAINNET_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
# ── Deployer key ─────────────────────────────
# EOA that broadcasts deployment transactions and pays gas.
# On mainnet use a dedicated deployer EOA, not the admin multisig.
PRIVATE_KEY=0x

# ── Role addresses ───────────────────────────
# All default to the deployer if left unset — fine for local / testnet.
# On mainnet ADMIN_ADDRESS must be the Safe multisig.

# Holds DEFAULT_ADMIN_ROLE: upgrade proxy, manage roles, force-cancel positions.
# Production: Safe multisig (e.g. 0xec465690340D7Cd6E9eC5C8ecb63eE841E5980dc)
ADMIN_ADDRESS=

# Holds OPERATOR_ROLE: settle orders/offers, refund, pause.
OPERATOR_ADDRESS=

# Holds KYC_OPERATOR_ROLE: signs KYC attestations authorising user actions.
# Keep this key in a secure secrets manager; exposure allows bypassing KYC gates.
KYC_SIGNER_ADDRESS=

# Holds FEE_OPERATOR_ROLE: signs fee attestations (separate fee service, not KYC).
# Keep this key in a secure secrets manager; exposure allows setting arbitrary fees
# (bounded on-chain by MAX_FEE_BPS and the feeCollector allowlist).
FEE_SIGNER_ADDRESS=

# Recorded in the deployment manifest for reference; not granted any on-chain role.
RELAYER_ADDRESS=

# ── Per-offering issuance venue (script/DeployIssuanceVenue.s.sol) ────────────
# Only needed when deploying ONE offering's primary sale contract
# (AsseteraIssuanceVenue). Not part of the platform stack: Deploy.s.sol ignores
# every variable below, and nothing here is written to the SDK manifest.

# The currency the offering is sold in, and the asset it mints.
VENUE_SETTLEMENT_TOKEN=
VENUE_ASSET_TOKEN=

# ⚠️ RAW SETTLEMENT-TOKEN AMOUNTS, not decimals, and this is where a decimals
# mistake lives. The price is the cost of ONE WHOLE asset token expressed in the
# settlement token's smallest unit. With a 6-decimal mUSDC:
#   12.50 per token  -> 12500000
#   floor of 0.01    -> 10000
#   ceiling of 10000 -> 10000000000
VENUE_UNIT_PRICE=
VENUE_MIN_UNIT_PRICE=
VENUE_MAX_UNIT_PRICE=

# Per-purchase cap in WHOLE settlement tokens. Sized as a bound on arithmetic
# and decimals BUGS (ten to a hundred times the largest plausible purchase), not
# as a loss limit. ⚠️ 0 deploys the venue CLOSED.
VENUE_MAX_SETTLEMENT_WHOLE=

# The AsseteraPrimarySales proxy — the venue's ONE permitted caller, immutable
# once deployed. Defaults to the address recorded for this chain in
# packages/sdk/src/deployments/<chainId>.json; set only to override.
VENUE_ROUTER=

# Role holders. Each defaults to the deployer, which is fine for a testnet dry
# run and is not fine for a real offering.
#   VENUE_ADMIN       role administration, the purchase cap, unpause
#   VENUE_RATE_SETTER may reprice within the bounds above, and nothing else
#   VENUE_PAUSER      may stop purchases; may NOT restart them
#   VENUE_TREASURY    the issuer: withdraws proceeds, rescues a stray token
VENUE_ADMIN=
VENUE_RATE_SETTER=
VENUE_PAUSER=
VENUE_TREASURY=
