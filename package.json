{
  "name": "evm-contracts-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the Assetera EVM contracts + generated SDK (ADR-0026).",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @asseteragmbh/evm-contracts",
    "typecheck": "npm run typecheck -w @asseteragmbh/evm-contracts",
    "anvil": "anvil",
    "deploy:local": "bash scripts/deploy-local.sh",
    "dryrun:amoy": "bash scripts/deploy.sh amoy",
    "dryrun:sepolia": "bash scripts/deploy.sh sepolia",
    "deploy:amoy": "bash scripts/deploy.sh amoy --broadcast",
    "deploy:sepolia": "bash scripts/deploy.sh sepolia --broadcast",
    "verify:amoy": "cd contracts && forge script script/Verify.s.sol:Verify --rpc-url amoy -vv",
    "verify:sepolia": "cd contracts && forge script script/Verify.s.sol:Verify --rpc-url sepolia -vv",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.0"
  }
}
