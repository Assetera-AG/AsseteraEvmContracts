{
  "name": "evm-contracts-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the Assetera EVM contracts + generated SDK (ADR-0026).",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @asseteragmbh/evm-contracts",
    "typecheck": "npm run typecheck -w @asseteragmbh/evm-contracts",
    "anvil": "anvil",
    "deploy:local": "bash scripts/deploy-local.sh",
    "dryrun:amoy": "bash scripts/deploy.sh amoy",
    "dryrun:sepolia": "bash scripts/deploy.sh sepolia",
    "dryrun:polygon": "bash scripts/deploy.sh polygon",
    "dryrun:mainnet": "bash scripts/deploy.sh mainnet",
    "deploy:amoy": "bash scripts/deploy.sh amoy --broadcast",
    "deploy:sepolia": "bash scripts/deploy.sh sepolia --broadcast",
    "deploy:polygon": "bash scripts/deploy.sh polygon --broadcast",
    "deploy:mainnet": "bash scripts/deploy.sh mainnet --broadcast",
    "upgrade-calldata:dryrun:polygon": "FORGE_SCRIPT=UpgradeCalldata.s.sol:UpgradeCalldata TARGET=primary bash scripts/deploy.sh polygon",
    "upgrade-calldata:dryrun:mainnet": "FORGE_SCRIPT=UpgradeCalldata.s.sol:UpgradeCalldata TARGET=primary bash scripts/deploy.sh mainnet",
    "upgrade-calldata:polygon": "FORGE_SCRIPT=UpgradeCalldata.s.sol:UpgradeCalldata TARGET=primary bash scripts/deploy.sh polygon --broadcast",
    "upgrade-calldata:mainnet": "FORGE_SCRIPT=UpgradeCalldata.s.sol:UpgradeCalldata TARGET=primary bash scripts/deploy.sh mainnet --broadcast",
    "verify:amoy": "bash scripts/forge-script.sh amoy Verify.s.sol:Verify -vv",
    "verify:sepolia": "bash scripts/forge-script.sh sepolia Verify.s.sol:Verify -vv",
    "verify:polygon": "bash scripts/forge-script.sh polygon Verify.s.sol:Verify -vv",
    "verify:mainnet": "bash scripts/forge-script.sh mainnet Verify.s.sol:Verify -vv",
    "admin-calldata:amoy": "bash scripts/forge-script.sh amoy AdminCalldata.s.sol:AdminCalldata -vv",
    "admin-calldata:sepolia": "bash scripts/forge-script.sh sepolia AdminCalldata.s.sol:AdminCalldata -vv",
    "admin-calldata:polygon": "bash scripts/forge-script.sh polygon AdminCalldata.s.sol:AdminCalldata -vv",
    "admin-calldata:mainnet": "bash scripts/forge-script.sh mainnet AdminCalldata.s.sol:AdminCalldata -vv",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.0"
  }
}
